PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Google Maps Platform - Places API (New) Key (Optional, fallback mock data used if empty)
GOOGLE_MAPS_API_KEY=

# ExchangeRate-API Key (Optional, free tier fallback rates used if empty)
EXCHANGE_RATE_API_KEY=

# In-Memory Cache TTL in seconds (86400 = 24 hours)
CACHE_TTL_SECONDS=86400
